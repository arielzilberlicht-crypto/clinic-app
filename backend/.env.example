GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=doctor.zilberlicht@gmail.com
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/oauth/callback
DOCTOR_PHONE=972522904352
PORT=3000

# ─── Clinic Automation Hub (phase 0, read-only) ────────────────────────────────
# See README "Clinic Automation Hub" section for how to obtain each value and
# how to rotate credentials. Nothing here is committed to the repo.

# ID of the "Clinic Automation Hub - Dr Ariel Zilberlicht" spreadsheet.
HUB_SPREADSHEET_ID=
# Leave empty to reuse HUB_SPREADSHEET_ID; the leads sheet ("קליטת ליד מהאתר
# אריאל") is currently a separate spreadsheet.
HUB_LEADS_SPREADSHEET_ID=

# Tab names, only override if the doctor renames a tab.
HUB_TAB_APPOINTMENTS=Appointments
HUB_TAB_BOT_STATE=Bot_State
HUB_TAB_COMMUNICATIONS=Communications
HUB_TAB_PATIENTS=Patients
HUB_TAB_ALERTS=Alerts
HUB_TAB_LEADS=קליטת ליד

# Google Cloud service account with Viewer access to ONLY the spreadsheet(s)
# above (share the sheet with this email, do not grant Drive-wide access).
HUB_GOOGLE_SERVICE_ACCOUNT_EMAIL=
HUB_GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# OAuth 2.0 Client ID (Web application) used for Google Sign-In on the Hub.
HUB_GOOGLE_OAUTH_CLIENT_ID=

# Random long string used to sign Hub session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
HUB_SESSION_SECRET=

# Allow-list of Google accounts permitted to sign in, JSON array of
# {"email": "...", "role": "DOCTOR" | "SECRETARY"}.
HUB_ALLOWED_USERS=[]

# How long Sheets reads are cached, in seconds (1-5 minutes recommended).
HUB_CACHE_TTL_SECONDS=120
